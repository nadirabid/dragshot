{
  "name": "dsh-dragshot",
  "version": "0.2.0",
  "private": true,
  "description": "Local DragShot bridge for DeepSeek Harness: accepts a screenshot and note and sends them to a chosen, new, or most recently used DSH session.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/bridge.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
