{
  "name": "dsh-lookit",
  "version": "0.4.0",
  "private": true,
  "description": "Local Lookit bridge for DeepSeek Harness: accepts a screenshot and note and sends them to a chosen, new, or most recently used DSH session.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/bridge.js",
    "cordis.patch.yml",
    "README.md",
    "lib/client.js",
    "lib/navigation.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  }
}
